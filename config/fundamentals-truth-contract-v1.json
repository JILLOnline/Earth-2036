{
  "version": "1.0.0",
  "contract": "earth2036-fundamentals-truth-v1",
  "status": "lab-audit",
  "system": "lab",
  "canonicalWriteAuthority": false,
  "purpose": "Create deterministic, point-in-time, source-addressed fundamental observations from SEC XBRL Company Facts without training on Earth scores, narrative judgments or invented financial labels.",
  "authority": {
    "primary": "SEC EDGAR XBRL Company Facts API",
    "endpointTemplate": "https://data.sec.gov/api/xbrl/companyfacts/CIK##########.json",
    "bulkScalePath": "https://www.sec.gov/Archives/edgar/daily-index/xbrl/companyfacts.zip",
    "authenticationRequired": false,
    "customTaxonomyPolicy": "Company Facts exposes standard taxonomy facts only; missing extension-only disclosures remain unknown rather than inferred."
  },
  "pointInTime": {
    "required": true,
    "rule": "A source fact is eligible only when filed <= asOf.",
    "futureLeakageForbidden": true,
    "preserveAllEligibleVersions": true,
    "latestContextVersionIsMechanical": true
  },
  "sourceFactRequiredFields": [
    "taxonomy",
    "tag",
    "unit",
    "val",
    "start",
    "end",
    "filed",
    "accn",
    "form",
    "fy",
    "fp",
    "frame"
  ],
  "metrics": [
    "revenue",
    "gross_profit",
    "operating_income",
    "net_income",
    "operating_cash_flow",
    "capital_expenditures",
    "cash_and_equivalents",
    "debt_current",
    "debt_noncurrent",
    "shares_outstanding"
  ],
  "derivedMetrics": [
    "free_cash_flow",
    "gross_margin",
    "operating_margin",
    "net_margin",
    "total_debt"
  ],
  "derivedPolicy": {
    "rule": "Derived values are mechanical transformations of selected source facts only.",
    "provenanceRequired": true,
    "noCrossCurrencyMath": true,
    "noCrossPeriodMath": true,
    "ambiguousInputsYieldUnknown": true,
    "missingInputsYieldUnknown": true
  },
  "ambiguityPolicy": {
    "conflictingStandardConcepts": "unknown",
    "conflictingUnits": "separate; never converted silently",
    "missingFact": "unknown",
    "extensionOnlyDisclosure": "unknown",
    "humanOverrideAllowed": false
  },
  "governance": {
    "mayChangeEarthScore": false,
    "mayChangeCanonicalRank": false,
    "mayChangeWorkgraphState": false,
    "mayAffectT0Qualification": false,
    "promotionRequires": "separate audited governance change after truth-pipeline validation"
  }
}
