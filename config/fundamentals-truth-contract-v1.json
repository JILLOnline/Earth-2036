{
  "version": "1.1.0",
  "contract": "earth2036-fundamentals-truth-v1",
  "status": "audited-lab",
  "system": "lab",
  "canonicalWriteAuthority": false,
  "purpose": "Preserve deterministic point-in-time SEC XBRL observations as machine truth. Human-selected financial metrics are convenience projections only; the learner retains access to the complete eligible non-custom taxonomy fact set.",
  "authority": {
    "primary": "SEC EDGAR XBRL Company Facts API",
    "endpointTemplate": "https://data.sec.gov/api/xbrl/companyfacts/CIK##########.json",
    "bulkScalePath": "https://www.sec.gov/Archives/edgar/daily-index/xbrl/companyfacts.zip",
    "authenticationRequired": false,
    "sourceClass": "primary-regulatory",
    "customTaxonomyPolicy": "Company Facts aggregates entity-wide facts from non-custom taxonomies. Extension-only disclosures remain absent/unknown rather than inferred."
  },
  "pointInTime": {
    "required": true,
    "futureLeakageForbidden": true,
    "rule": "A fact is eligible only when its SEC filed date is available by the requested asOf cutoff.",
    "preserveAllEligibleVersions": true,
    "sameDayPolicy": "conservative-end-of-UTC-day",
    "sameDayConflictPolicy": "retain-all-latest-day-versions-and-mark-conflict-ambiguous",
    "note": "Company Facts exposes filing date in fact records rather than an acceptance timestamp; this layer delays same-day facts until UTC day end and never invents an ordering among conflicting same-day accessions."
  },
  "rawTruth": {
    "learnerAuthority": "allEligibleNonCustomTaxonomyFacts",
    "baselineTaxonomies": [
      "us-gaap",
      "ifrs-full",
      "dei",
      "srt"
    ],
    "preserveUnknownNonCustomTaxonomies": true,
    "preserveAllUnits": true,
    "preserveAllForms": true,
    "noSilentCurrencyConversion": true,
    "noHumanMetricFilterForLearning": true,
    "excludeUntimestampedConceptMetadataFromLearning": true,
    "rawFactIdentity": [
      "taxonomy",
      "tag",
      "unit",
      "val",
      "start",
      "end",
      "filed",
      "accn",
      "form",
      "fy",
      "fp",
      "frame"
    ],
    "retrievedPayloadHashRequired": true,
    "retrievedPayloadHashPointInTimeAuthority": false,
    "sourcePayloadHashRequired": true,
    "sourcePayloadHashSemantics": "CIK + asOf + point-in-time taxonomy set + eligible raw facts hash/count only",
    "rawFactsHashRequired": true,
    "truthHashScope": "raw point-in-time fact state only",
    "projectionHashSeparate": true,
    "recordHashSeparate": true
  },
  "normalizedProjection": {
    "learningAuthority": false,
    "purpose": "Mechanical convenience view for audit and later outcome calculations; never the only feature space available to learning.",
    "metrics": [
      "revenue",
      "gross_profit",
      "operating_income",
      "net_income",
      "operating_cash_flow",
      "capital_expenditures",
      "cash_and_equivalents",
      "long_term_debt_current",
      "long_term_debt_noncurrent",
      "borrowings_current_ifrs",
      "borrowings_noncurrent_ifrs",
      "shares_outstanding"
    ],
    "derived": [
      "free_cash_flow",
      "gross_margin",
      "operating_margin",
      "net_margin"
    ],
    "ambiguityPolicy": "unknown-not-reconciled",
    "periodicForms": [
      "10-K",
      "10-K/A",
      "10-Q",
      "10-Q/A",
      "10-KT",
      "10-KT/A",
      "10-QT",
      "10-QT/A",
      "20-F",
      "20-F/A",
      "40-F",
      "40-F/A"
    ],
    "transitionFormsAreSeparatePeriodClass": true,
    "excludeFromNormalized": [
      "8-K",
      "8-K/A",
      "6-K",
      "6-K/A"
    ],
    "derivedSameAccessionRequired": true,
    "noTotalDebtSynthesisV1": true
  },
  "amendmentPolicy": {
    "historyImmutable": true,
    "sameEconomicContext": "taxonomy + tag + unit + start + end",
    "currentVersion": "all versions on the latest eligible filed date for the same economic context",
    "strictlyOlderFiledDatesAreSuperseded": true,
    "sameDayConflictsRemainCurrentAndAmbiguous": true,
    "supersededVersionsPreserved": true
  },
  "identity": {
    "cikMismatchPolicy": "fail-closed",
    "tickerAndEntityNameAreRecordMetadataNotTruthIdentity": true
  },
  "persistence": {
    "mode": "immutable-content-addressed-snapshots",
    "pathShape": "ticker/asOf/truthHash.json",
    "overwriteForbidden": true,
    "gitTrackedRuntimeSnapshots": false
  },
  "missingData": {
    "missingMeans": "unknown",
    "zeroImputationForbidden": true,
    "favorableImputationForbidden": true,
    "extensionOnlyMeans": "unknown",
    "sectorSpecificProjectionGapMeans": "unknown-not-zero"
  },
  "governance": {
    "mayChangeEarthScore": false,
    "mayChangeCanonicalRank": false,
    "mayChangeWorkgraphState": false,
    "mayAffectT0Qualification": false,
    "mayTrainTrajectoryDirectly": false,
    "promotionRequires": "separate explicit governance change after the audited lab layer passes CI and live canaries"
  }
}
