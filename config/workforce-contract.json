{
  "version": 1,
  "principle": "Own your lane. Help every other lane. Never steal its authority.",
  "roles": {
    "earth-scout": {
      "owns": [
        "source acquisition",
        "discovery weak signals",
        "expectations/execution evidence"
      ],
      "mayAssist": [
        "source acquisition for Alpha",
        "source acquisition for Beta causal questions",
        "emerging need evidence"
      ],
      "mustNotOwn": [
        "numeric underwriting",
        "final causal judgment",
        "sovereign exceptions"
      ]
    },
    "council-alpha": {
      "owns": [
        "underwriting",
        "score evidence",
        "calibration application",
        "company needs/capabilities"
      ],
      "mayAssist": [
        "economic mechanism evidence",
        "financial interpretation"
      ],
      "mustNotOwn": [
        "red-team disposition",
        "sovereign exception resolution"
      ]
    },
    "council-beta": {
      "owns": [
        "structural causal analysis",
        "adversarial red team"
      ],
      "mayAssist": [
        "risk evidence",
        "bridge falsification",
        "externality analysis"
      ],
      "mustNotOwn": [
        "canonical numeric score",
        "sovereign exception resolution"
      ]
    },
    "deep-resolver": {
      "owns": [
        "genuine contradictions",
        "cross-lane deadlocks",
        "evidence ambiguity after root-owner work"
      ],
      "mayAssist": [
        "cross-engine disagreement diagnosis"
      ],
      "mustNotOwn": [
        "routine missing evidence",
        "routine underwriting",
        "broad discovery"
      ]
    },
    "chief-earth": {
      "owns": [
        "methodology decisions",
        "sovereign exceptions",
        "operational allocation policy",
        "constitutional integrity"
      ],
      "mayAssist": [
        "none; deterministic and specialist paths should be exhausted first"
      ],
      "mustNotOwn": [
        "routine source acquisition",
        "routine scoring",
        "routine reconciliation"
      ]
    }
  },
  "handoffRules": [
    "Every assist request retains a root owner.",
    "Helpers produce evidence or bounded analysis, not a replacement authoritative perspective.",
    "Unchanged failed requests become dormant until the input signature changes.",
    "A dependency cycle must be escalated as a deadlock, not circulated.",
    "No assist request can modify canonical state directly."
  ]
}
