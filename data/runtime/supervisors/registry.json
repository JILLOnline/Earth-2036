{
  "version": 3,
  "architectureVersion": "workgraph-v2",
  "principle": "Machine observes; specialists structure evidence; deterministic preflight earns chief_ready; one sovereign Chief adjudicates; deterministic engine verifies/finalizes.",
  "timezone": "America/New_York",
  "machineScheduleMinute": 0,
  "runnerScheduleMinutes": {
    "earth-scout": 5,
    "earth-council-alpha": 15,
    "earth-council-beta": 25,
    "earth-deep-resolver": 35,
    "chief-earth": 45
  },
  "operatingShifts": [
    {
      "id": "graveyard",
      "label": "GRAVEYARD",
      "window": "00:00–05:59 ET",
      "startHour": 0,
      "endHour": 6,
      "mode": "DEEP / EXCEPTION / LOST-SCROLL RESEARCH"
    },
    {
      "id": "adaptation-dawn",
      "label": "ADAPTATION",
      "window": "06:00–06:59 ET",
      "startHour": 6,
      "endHour": 7,
      "mode": "HANDOFF / CONSOLIDATION"
    },
    {
      "id": "day",
      "label": "DAY SHIFT",
      "window": "07:00–22:59 ET",
      "startHour": 7,
      "endHour": 23,
      "mode": "NORMAL OPERATIONS / T0 ADVANCEMENT"
    },
    {
      "id": "adaptation-night",
      "label": "ADAPTATION",
      "window": "23:00–23:59 ET",
      "startHour": 23,
      "endHour": 24,
      "mode": "HANDOFF / CONSOLIDATION"
    }
  ],
  "automationSlotStrategy": {
    "mode": "five-intelligent-workers-workgraph-v2",
    "reason": "Keep deterministic machine/watchdog work in GitHub and spend all five ChatGPT automation slots on judgment-heavy intelligence. Preserve all six required analytical perspectives without a second sovereign Chief.",
    "periodicDecisionTasksAbsorbedByChief": ["weekly-top-10", "monthly-top-5", "quarterly-top-3", "annual-cohort"],
    "requiredLogicalLanes": 6,
    "earthAutomationSlotsUsed": 5,
    "activeScheduledTasks": ["earth-scout", "earth-council-alpha", "earth-council-beta", "earth-deep-resolver", "chief-earth"],
    "note": "Clock times are scheduling opportunities only. Workers consume the newest complete eligible work/cycle with exact lineage; they do not infer cycle identity from time."
  },
  "workers": [
    {
      "id": "earth-scout",
      "name": "Earth Scout",
      "scheduleMinute": 5,
      "role": "DISCOVERY / TRIAGE / EXPECTATIONS",
      "summary": "Watches the broad discovery population, triages meaningful deltas, and owns Discovery & Weak Signals plus Expectations & Execution."
    },
    {
      "id": "earth-council-alpha",
      "name": "Council Alpha",
      "scheduleMinute": 15,
      "role": "2 REQUIRED LANES",
      "summary": "Runs Source & Integrity and Company Underwriting as independent evidence passes."
    },
    {
      "id": "earth-council-beta",
      "name": "Council Beta",
      "scheduleMinute": 25,
      "role": "2 REQUIRED LANES",
      "summary": "Runs Structural & Causal and Adversarial Red Team as independent evidence passes."
    },
    {
      "id": "earth-deep-resolver",
      "name": "Deep Resolver",
      "scheduleMinute": 35,
      "role": "EXCEPTION RESOLUTION",
      "summary": "Works only exact hard gates, contradictions, provenance failures and obscure evidence paths; never duplicates routine underwriting."
    },
    {
      "id": "chief-earth",
      "name": "Chief Earth",
      "scheduleMinute": 45,
      "role": "ADJUDICATE / PROMOTE / ATTEST",
      "summary": "Single sovereign intelligent authority for chief_ready packet adjudication, canonical promotion, directives and period decisions."
    }
  ],
  "runners": [
    {
      "id": "earth-scout",
      "scheduleMinute": 5,
      "lanes": ["discovery-weak-signals", "expectations-execution"],
      "independenceRule": "Discovery and expectations are separate analytical passes even though one scheduler container owns both."
    },
    {
      "id": "earth-council-alpha",
      "scheduleMinute": 15,
      "lanes": ["source-integrity", "company-underwriting"],
      "independenceRule": "Each lane completes independently before cross-lane synthesis."
    },
    {
      "id": "earth-council-beta",
      "scheduleMinute": 25,
      "lanes": ["structural-causal", "adversarial-red-team"],
      "independenceRule": "Each lane completes independently before cross-lane synthesis."
    }
  ],
  "lanes": [
    {
      "id": "source-integrity",
      "name": "Source & Integrity Supervisor",
      "runnerId": "earth-council-alpha",
      "owns": ["source capability", "freshness", "identity", "tradability", "provenance", "deduplication", "evidence aging", "runtime/repo/sheet consistency", "queue integrity"]
    },
    {
      "id": "company-underwriting",
      "name": "Company Underwriting Supervisor",
      "runnerId": "earth-council-alpha",
      "owns": ["fundamentals", "operations", "financials", "contracts/backlog", "customers", "management", "governance", "rubric evidence", "company risks"]
    },
    {
      "id": "structural-causal",
      "name": "Structural & Causal Supervisor",
      "runnerId": "earth-council-beta",
      "owns": ["2036 alignment", "bottlenecks", "scarcity", "substitution", "constraint migration", "cross-division leverage", "supply chains", "second/third-order effects", "regime shifts", "causal falsifiers"]
    },
    {
      "id": "discovery-weak-signals",
      "name": "Discovery & Weak-Signal Supervisor",
      "runnerId": "earth-scout",
      "owns": ["unbounded discovery", "new listings", "patents", "hiring", "procurement", "research", "regulation", "emerging technologies", "blind spots", "weak-signal convergence", "unknown-unknown audits"]
    },
    {
      "id": "adversarial-red-team",
      "name": "Adversarial Red-Team Supervisor",
      "runnerId": "earth-council-beta",
      "owns": ["contradictions", "pre-mortems", "source dependence", "fraud/accounting patterns", "dilution", "customer concentration", "technological displacement", "narrative lock-in", "confidence inflation", "thesis falsification"]
    },
    {
      "id": "expectations-execution",
      "name": "Expectations & Execution Supervisor",
      "runnerId": "earth-scout",
      "owns": ["valuation", "market expectations", "consensus divergence", "Opportunity Score", "Execution Score", "event asymmetry", "forecasts", "calibration", "catalyst calendar", "reward/risk", "crowding"]
    }
  ],
  "deepRunner": {
    "id": "earth-deep-resolver",
    "name": "Earth Deep Resolver",
    "scheduleMinute": 35,
    "requiredLaneSubstitute": false,
    "owns": ["exact gating exceptions", "obscure lawful primary evidence", "identity/tradability/provenance conflicts", "capital-structure reconciliation", "hard causal contradictions", "evidence-origin reconstruction"]
  },
  "chief": {
    "id": "chief-earth",
    "name": "Chief Earth Supervisor",
    "scheduleMinute": 45,
    "owns": ["chief_ready adjudication", "disagreement resolution", "canonical promotion", "research directives", "Sheet mirror", "T0 authority", "tick attestation", "weekly/monthly/quarterly/annual decision cadence", "self-audit", "surprise learning", "user escalation"]
  }
}
